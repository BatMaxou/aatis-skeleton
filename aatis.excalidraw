      "seed": 1369478039,
      "version": 1014,
      "versionNonce": 1994817881,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754653745882,
      "link": null,
      "locked": false,
      "text": "<?php\n\n$cacheSystem = new CacheSystem('directory');\n\n$cacheSystem->set('key', expires, 'pool');\n\n$value = Cache->get('key', expires, 'pool');\n\n// Clear special pools\n$cacheSystem->clear(['pool_1', 'pool_2']);\n\n// Clear default pool\n$cacheSystem->clear();\n\n// Clear all pools\n$cacheSystem->clear(CacheSystem::ALL)\n\n// Même système que clear() mais pour les données expirées\n$cacheSystem->sweep()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<?php\n\n$cacheSystem = new CacheSystem('directory');\n\n$cacheSystem->set('key', expires, 'pool');\n\n$value = Cache->get('key', expires, 'pool');\n\n// Clear special pools\n$cacheSystem->clear(['pool_1', 'pool_2']);\n\n// Clear default pool\n$cacheSystem->clear();\n\n// Clear all pools\n$cacheSystem->clear(CacheSystem::ALL)\n\n// Même système que clear() mais pour les données expirées\n$cacheSystem->sweep()",
      "autoResize": true,
      "lineHeight": 1.25
    },
