{
  "name": "aatis/skeleton",
  "type": "project",
  "description": "A base skeleton to start properly with Aatis",
  "authors": [
    {
      "name": "Maxime Batista",
      "email": "maximebatista.lycee@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "./src/",
      "Aatis\\": "./.aatis/kernel/src/",
      "Aatis\\DependencyInjection\\": "./.aatis/dependency-injection/src/",
      "Aatis\\HttpFoundation\\": "./.aatis/http-foundation/src/",
      "Aatis\\Routing\\": "./.aatis/routing/src/",
      "Aatis\\ErrorHandler\\": "./.aatis/error-handler/src/",
      "Aatis\\EventDispatcher\\": "./.aatis/event-dispatcher/src/",
      "Aatis\\FileManager\\": "./.aatis/file-manager/src/",
      "Aatis\\Logger\\": "./.aatis/logger/src/",
      "Aatis\\OptionsResolver\\": "./.aatis/options-resolver/src/",
      "Aatis\\TemplateRenderer\\": "./.aatis/template-renderer/src/",
      "Aatis\\Tester\\": "./.aatis/tester/src/" 
    }
  },
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6",
    "symfony/yaml": "^6.3",
    "psr/container": "^1.0",
    "psr/log": "^3.0",
    "psr/event-dispatcher": "^1.0",
    "twig/twig": "^3.8"
  },
  "require-dev": {
    "symfony/var-dumper": "^6.3",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^1.12"
  }
}
